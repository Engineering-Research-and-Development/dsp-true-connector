		{
			"name": "Create tenant",
			"item": [
				{
					"name": "Create new tenant",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test Tenant\",\n  \"description\": \"Created by automated test\",\n  \"connectorId\": \"urn:test:connector\",\n  \"callbackAddress\": \"http://test.example.com\",\n  \"automaticNegotiation\": false,\n  \"automaticTransfer\": false\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{CONSUMER}}/api/v1/tenants",
							"host": [
								"{{CONSUMER}}"
							],
							"path": [
								"api",
								"v1",
								"tenants"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
									"pm.test('Response has data', function () {",
									"  var jsonData = pm.response.json();",
									"  pm.expect(jsonData.data).to.exist;",
									"  pm.expect(jsonData.data.id).to.exist;",
									"  pm.expect(jsonData.data.name).to.eql('Test Tenant');",
									"  pm.expect(jsonData.data.enabled).to.be.false;",
									"  pm.collectionVariables.set('NEW_TENANT_ID', jsonData.data.id);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Get all tenants - new tenant present",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{CONSUMER}}/api/v1/tenants",
							"host": [
								"{{CONSUMER}}"
							],
							"path": [
