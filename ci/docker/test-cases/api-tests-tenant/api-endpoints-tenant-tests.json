    {
      "name": "Login",
      "item": [
        {
          "name": "Auth login SUPERADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "//extract the access_token and refresh_token from the response body and store them in environment variables.\r",
                  "pm.test(\"Retrieve access_token\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.collectionVariables.set(\"auth_jwt_superadmin\", jsonData[\"access_token\"])\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"superadmin@mail.com\",\r\n    \"password\": \"password\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{CONSUMER_AUTH_LOGIN}}",
              "host": [
                "{{CONSUMER_AUTH_LOGIN}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Create tenant",
      "item": [
        {
          "name": "Create new tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response has data', function () {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data).to.exist;",
                  "  pm.expect(jsonData.data.id).to.exist;",
                  "  pm.expect(jsonData.data.name).to.eql('Test Tenant');",
                  "  pm.expect(jsonData.data.enabled).to.be.false;",
                  "  pm.collectionVariables.set('NEW_TENANT_ID', jsonData.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Tenant\",\n  \"description\": \"Created by automated test\",\n  \"automaticNegotiation\": false,\n  \"automaticTransfer\": false,\n  \"id\": \"test-tenant-crud-id\",\n  \"participantId\": \"urn:test:connector\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{CONSUMER}}/api/v1/tenants",
              "host": [
                "{{CONSUMER}}"
              ],
              "path": [
                "api",
                "v1",
                "tenants"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get all tenants - new tenant present",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('New tenant appears in list', function () {",
                  "  var jsonData = pm.response.json();",
                  "  var tenants = jsonData.response.data.content;",
                  "  var found = tenants.some(function(t) { return t.id === pm.collectionVariables.get('NEW_TENANT_ID'); });",
                  "  pm.expect(found).to.be.true;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{CONSUMER}}/api/v1/tenants",
              "host": [
                "{{CONSUMER}}"
              ],
              "path": [
                "api",
                "v1",
                "tenants"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get tenant by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Tenant data is correct', function () {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.data.id).to.eql(pm.collectionVariables.get('NEW_TENANT_ID'));",
                  "  pm.expect(jsonData.data.name).to.eql('Test Tenant');",
                  "  pm.expect(jsonData.data.participantId).to.eql('urn:test:connector');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
