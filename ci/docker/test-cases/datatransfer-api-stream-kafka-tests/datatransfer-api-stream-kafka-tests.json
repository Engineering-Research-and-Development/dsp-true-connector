    {
      "name": "[C] Wait for transfer COMPLETED",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const w = Date.now() + 1000; while (Date.now() < w) {}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const retries = parseInt(pm.collectionVariables.get('waitRetry') || '0');\nconst body = pm.response.json();\nconst state = body.data && body.data.state;\nif (state !== 'COMPLETED' && retries < 30) {\n    pm.collectionVariables.set('waitRetry', retries + 1);\n    pm.execution.setNextRequest('[C] Wait for transfer COMPLETED');\n} else {\n    pm.collectionVariables.set('waitRetry', 0);\n    pm.test('Transfer process reached COMPLETED state', () => {\n        pm.expect(state).to.eql('COMPLETED');\n    });\n}"
            ]
          }
        }
      ],
