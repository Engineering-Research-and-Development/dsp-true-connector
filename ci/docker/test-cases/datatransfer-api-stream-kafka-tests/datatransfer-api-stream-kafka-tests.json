    {
      "name": "[P] Start transfer",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Check if status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Provider start returns Kafka connection properties\", function () {\r\n    var jsonData = pm.response.json();\r\n    var props = jsonData[\"data\"][\"dataAddress\"][\"endpointProperties\"];\r\n    var endpointType = props.find(p => p.name === 'endpointType');\r\n    var bootstrapServers = props.find(p => p.name === 'bootstrapServers');\r\n    var topic = props.find(p => p.name === 'topic');\r\n    pm.expect(endpointType && endpointType.value).to.eql('kafka');\r\n    pm.expect(bootstrapServers && bootstrapServers.value).to.be.ok;\r\n    pm.expect(topic && topic.value).to.match(/^stream-topic-/);\r\n});"
            ]
          }
        }
      ],
