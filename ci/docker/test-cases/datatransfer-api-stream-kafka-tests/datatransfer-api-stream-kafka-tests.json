          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Check if status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Retrieve provider transfer process id\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.collectionVariables.set(\"provider_transferProcessId\", \r\n    jsonData[\"response\"][\"data\"][\"content\"][0][\"@id\"])\r\n});"
            ]
          }
        }
      ],
