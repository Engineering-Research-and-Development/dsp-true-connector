    {
      "name": "[C] Wait for transfer COMPLETED",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// 1-second busy-wait between polling attempts",
              "const w = Date.now() + 1000; while (Date.now() < w) {}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const retries = parseInt(pm.collectionVariables.get('waitRetry') || '0');",
              "const body = pm.response.json();",
              "const state = body.data && body.data.state;",
              "if (state !== 'COMPLETED' && retries < 30) {",
              "    pm.collectionVariables.set('waitRetry', retries + 1);",
              "    pm.execution.setNextRequest('[C] Wait for transfer COMPLETED');",
              "} else {",
              "    pm.collectionVariables.set('waitRetry', 0);",
              "    pm.test('Transfer process reached COMPLETED state', () => {",
              "        pm.expect(state).to.eql('COMPLETED');",
              "    });",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{CONSUMER_API_TRANSFERS}}/{{consumer_transferProcessId}}",
          "host": [
            "{{CONSUMER_API_TRANSFERS}}"
          ],
          "path": [
            "{{consumer_transferProcessId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[C] View data",
      "event": [
