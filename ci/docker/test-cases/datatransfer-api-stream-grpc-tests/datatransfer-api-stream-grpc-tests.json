    {
      "name": "[P] Start transfer",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Check if status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "pm.test(\"Provider start returns gRPC connection properties\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    var props = jsonData[\"data\"][\"dataAddress\"][\"endpointProperties\"];\r",
              "    var endpointType = props.find(p => p.name === 'endpointType');\r",
              "    var host = props.find(p => p.name === 'host');\r",
              "    var port = props.find(p => p.name === 'port');\r",
              "    var sessionId = props.find(p => p.name === 'sessionId');\r",
              "    pm.expect(endpointType && endpointType.value).to.eql('grpc');\r",
              "    pm.expect(host && host.value).to.be.ok;\r",
              "    pm.expect(port && port.value).to.eql('9095');\r",
              "    pm.expect(sessionId && sessionId.value).to.be.ok;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "",
