        ],
        "url": {
          "raw": "{{PROVIDER_API_TRANSFERS}}?state=REQUESTED&role=provider&datasetId=urn:uuid:fdc45798-a222-4955-8baf-ab7fd66ac4d5",
          "host": [
            "{{PROVIDER_API_TRANSFERS}}"
          ],
          "query": [
            {
              "key": "state",
              "value": "REQUESTED"
            },
            {
              "key": "role",
              "value": "provider"
            },
            {
              "key": "datasetId",
              "value": "urn:uuid:fdc45798-a222-4955-8baf-ab7fd66ac4d5"
            }
          ]
        }
      },
      "response": []
