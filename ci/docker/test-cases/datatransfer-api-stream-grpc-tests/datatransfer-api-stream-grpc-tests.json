          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Check expected response\", ()=> {\r",
              "    pm.response.to.have.status(200);\r",
              "    var response = pm.response.text().trim().replace(/^\"|\"$/g, '');\r",
              "    pm.expect(response).to.match(/https?:\\/\\/[^/]+\\/dsp-true-connector-a\\//);\r",
              "    pm.collectionVariables.set(\"presignedURL\", response);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        },
